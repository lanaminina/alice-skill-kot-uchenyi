# Secrets live on the server (.env), not in git.
# Local / legacy Yandex direct (optional; prod uses LLM gateway):
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here

# msk01 Yandex LLM Gateway
LLM_GATEWAY_URL=http://127.0.0.1:8318/v1/chat/completions
LLM_GATEWAY_KEY=replace-me
LLM_MODEL=yandexgpt-5.1
VOICE_SPEAKER=erkanyavas

# Freemium / socratic caps (staging: FREE_LIMIT=999, SOCRATIC_MAX_STEPS=0)
FREE_LIMIT=5
SOCRATIC_MAX_STEPS=3
