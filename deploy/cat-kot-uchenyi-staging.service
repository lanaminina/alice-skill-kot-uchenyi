[Unit]
Description=Cat Kot Uchenyi - Alice Voice Skill (staging)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/alice-skill-kot-uchenyi/staging
EnvironmentFile=/opt/alice-skill-kot-uchenyi/staging.env
ExecStart=/opt/alice-skill-kot-uchenyi/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8021
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
